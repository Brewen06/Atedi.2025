<form
    method="post"
    action="{{ path('action_delete', {'id': action.id}) }}"
    onsubmit="return confirm('Voulez-vous vraiment supprimer cette action ?');"
    class='d-inline'
>
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ action.id) }}">
    <button class="red-btn f-20 px-4 py-2"><i class="fas fa-trash-alt mr-3"></i>Supprimer</button>
</form>
