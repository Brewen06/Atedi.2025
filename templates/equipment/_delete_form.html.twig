<form
    method="post"
    action="{{ path('equipment_delete', {'id': equipment.id}) }}"
    onsubmit="return confirm('Voulez-vous vraiment supprimer cet équipement ?');"
    class='d-inline'
>
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipment.id) }}">
    <button class="grey-btn f-20 px-4 py-2"><i class="fas fa-trash-alt mr-3"></i>Supprimer</button>
</form>
